{
  "name": "pune-smile-day",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute smileday-db --local --file worker/schema.sql",
    "db:init:remote": "wrangler d1 execute smileday-db --remote --file worker/schema.sql",
    "smoke": "node test/smoke.mjs",
    "set-token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-token.ps1",
    "local": "node test/dev-server.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
